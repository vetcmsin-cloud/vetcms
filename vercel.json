{
  "version": 2,
  "buildCommand": "vite build && esbuild server/serverless.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js --external:pg-native --external:bufferutil --external:utf-8-validate",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/uploads/(.*)", "destination": "/api" },
    { "source": "/r/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
